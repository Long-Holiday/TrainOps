{
  // 提供给 Antigravity CLI（agy）的模型训练监控者角色插件
  "name": "training-monitor",
  "displayName": "模型训练监控者",
  "version": "0.1.0",
  "description": "把一个远程 GPU 训练任务从开机到关机的全过程交给一个专职角色：管理 AutoDL 实例、同步代码、启动训练、定时巡检并汇报进度。适用于在 AutoDL 上跑长时间训练、需要有人盯着而不是自己盯着的场景。",
  "suggestedPrompts": [
    "开机我指定的 AutoDL 实例并启动本次训练任务",
    "巡检当前训练任务，汇报进度、GPU 占用和异常",
    "训练结束后确认检查点已保存，然后关闭实例"
  ]
}
